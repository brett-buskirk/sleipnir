#!/usr/bin/env bash
# sleipnir — a fast doctl wrapper for navigating your DigitalOcean estate.
# Odin's eight-legged steed: the swift mount that carries you across the realms.
#
#   sleipnir ls | ip | ssh | survey | apps | deploys | logs | config | install
#   run 'sleipnir help' for the menu, or 'sleipnir <command> help' for one command.
#
# Design floor (CLAUDE.md has the full version):
#   • Thin wrapper over `doctl` — never talks to the DO API directly.
#   • doctl owns auth; sleipnir NEVER reads, stores, or logs the DO token.
#   • Interactive ops only; standing infra stays in Terraform/Ansible.
#
# Deps: bash + doctl + jq. Every doctl-backed command sits behind require_doctl,
# so the meta commands (help/version/config) still work on a machine with no
# doctl account at all.
# shellcheck disable=SC2059  # color vars are fixed ANSI codes, deliberately embedded in format strings
set -uo pipefail

VERSION="0.1.0"
PROG="${0##*/}"

# ── configuration — env > config file > defaults ──────────────────────────────
# Sourced if present. Keep it SECRET-FREE: doctl owns auth, so this file holds
# only defaults and profiles. See sleipnir.config.example for the shape.
CONFIG="${SLEIPNIR_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/sleipnir/config}"
# Snapshot the environment before sourcing, so an explicit SLEIPNIR_* env var
# still beats the config file (the pack's precedence: env > file > default).
_env_REGION="${SLEIPNIR_REGION-}"
_env_SSH_USER="${SLEIPNIR_SSH_USER-}"
_env_SSH_IDENTITY="${SLEIPNIR_SSH_IDENTITY-}"
_env_VOLUME_PRICE_GIB="${SLEIPNIR_VOLUME_PRICE_GIB-}"
# shellcheck source=/dev/null
[ -f "$CONFIG" ] && . "$CONFIG"
REGION="${_env_REGION:-${SLEIPNIR_REGION:-nyc3}}"
SSH_USER="${_env_SSH_USER:-${SLEIPNIR_SSH_USER:-root}}"
# A local private-key path for `ssh -i`. Deliberately NOT the same thing as
# SLEIPNIR_SSH_KEYS, which holds public-key *fingerprints* for doctl to attach at
# create time (v2). One is a file on this machine, the other is an ID at DO.
SSH_IDENTITY="${_env_SSH_IDENTITY:-${SLEIPNIR_SSH_IDENTITY:-}}"
# Block-storage price per GiB/month, used by `survey` to cost volumes. doctl does
# not report a volume's price the way it does a droplet's size, so this is the one
# number sleipnir has to be told rather than read — in config, not hardcoded, so
# it can be corrected when DigitalOcean's pricing moves.
VOLUME_PRICE_GIB="${_env_VOLUME_PRICE_GIB:-${SLEIPNIR_VOLUME_PRICE_GIB:-0.10}}"

# ── palette — color only on a TTY, and never when NO_COLOR is set ─────────────
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; C=$'\e[36m'; DIM=$'\e[2m'; BD=$'\e[1m'; X=$'\e[0m'
else R=; G=; Y=; C=; DIM=; BD=; X=; fi

# ── small helpers ─────────────────────────────────────────────────────────────
have(){ command -v "$1" >/dev/null 2>&1; }
is_help(){ case "${1:-}" in help|-h|--help) return 0;; *) return 1;; esac; }
die(){ printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
warn(){ printf '%s: %s\n' "$PROG" "$*" >&2; }

# Compact age of a unix timestamp ("3d", "2w"). Same shape the pack uses. An
# empty or unparseable stamp renders as an em dash rather than "55y ago".
age_short(){
  local ts="${1:-}" now diff
  [[ "$ts" =~ ^[0-9]+$ ]] || { printf '—'; return 0; }
  now="$(date +%s)"; diff=$(( now - ts )); [ "$diff" -lt 0 ] && diff=0
  if   [ "$diff" -lt 3600 ];    then printf '%dm'  $(( diff/60 ))
  elif [ "$diff" -lt 86400 ];   then printf '%dh'  $(( diff/3600 ))
  elif [ "$diff" -lt 604800 ];  then printf '%dd'  $(( diff/86400 ))
  elif [ "$diff" -lt 2592000 ]; then printf '%dw'  $(( diff/604800 ))
  else                               printf '%dmo' $(( diff/2592000 )); fi
}

# DigitalOcean stamps are RFC3339, sometimes with fractional seconds that
# fromdateiso8601 refuses. Strip the fraction, and yield null rather than
# erroring out on anything unexpected.
JQ_EPOCH='def epoch: if type != "string" or . == "" then null
                     else (try (sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) catch null) end;'

# ── the active context — "which account am I about to hit?" ───────────────────
# doctl has named contexts the way gh has accounts, and hitting the wrong one is
# the DO analog of pushing as the wrong GitHub user. Both lookups are memoized so
# a run costs at most one extra API call, and both degrade to "" rather than
# failing a command over a cosmetic header.
CONTEXT=""; CONTEXT_SET=0
do_context(){
  [ "$CONTEXT_SET" = 1 ] || {
    CONTEXT="$(doctl auth list 2>/dev/null | sed -n 's/ (current)$//p' | head -1)"
    CONTEXT_SET=1
  }
  printf '%s' "$CONTEXT"
}

ACCOUNT_JSON=""; ACCOUNT_RC=-1
account_json(){
  if [ "$ACCOUNT_RC" -lt 0 ]; then
    ACCOUNT_JSON="$(doctl account get --output json 2>/dev/null)"; ACCOUNT_RC=$?
    jq -e 'type == "object"' >/dev/null 2>&1 <<<"$ACCOUNT_JSON" || { ACCOUNT_JSON='{}'; ACCOUNT_RC=1; }
  fi
  printf '%s' "$ACCOUNT_JSON"
  return "$ACCOUNT_RC"
}

# Team name for the header — falls back to the account email, then to nothing.
account_label(){ account_json 2>/dev/null | jq -r '.team.name // .email // empty' 2>/dev/null; }

# The one-line "you are here" banner every estate-wide view carries.
context_line(){
  local acct ctx out=""
  acct="$(account_label)"; ctx="$(do_context)"
  [ -n "$acct" ] && out="$acct"
  [ -n "$ctx" ] && out="${out:+$out · }context $ctx"
  printf '%s' "$out"
}

# ── preflight — dependencies + doctl auth ─────────────────────────────────────
# Call before any doctl-backed command. Returns non-zero (rather than exiting) so
# callers unwind normally and the process exit code still reflects the failure.
require_doctl(){
  have doctl || die "doctl not found — install it first (https://docs.digitalocean.com/reference/doctl/)."
  have jq    || die "jq not found — install it first."
  account_json >/dev/null 2>&1 && return 0
  local ctx; ctx="$(do_context)"
  printf "  ${R}doctl is not authenticated${X}%s\n" "${ctx:+ ${DIM}(active context: $ctx)${X}}" >&2
  printf "  ${DIM}run  doctl auth init  — or switch context:  doctl auth switch --context <name>${X}\n" >&2
  return 1
}

# ── droplet inventory ─────────────────────────────────────────────────────────
# Memoized: one `doctl compute droplet list` per run, shared by ls / ip / ssh.
# Returns non-zero when doctl itself failed, so callers can tell "couldn't ask"
# apart from "nothing there" — an empty account and a broken token must not look
# the same.
DROPLETS_JSON=""; DROPLETS_RC=-1
droplets_json(){
  if [ "$DROPLETS_RC" -lt 0 ]; then
    local raw
    raw="$(doctl compute droplet list --output json 2>&1)"; DROPLETS_RC=$?
    if [ "$DROPLETS_RC" -ne 0 ]; then
      warn "doctl could not list droplets — $(head -1 <<<"$raw")"
      DROPLETS_JSON='[]'
    elif jq -e 'type == "array"' >/dev/null 2>&1 <<<"$raw"; then
      DROPLETS_JSON="$raw"
    else
      DROPLETS_JSON='[]'   # doctl emits `null`, not `[]`, for an empty account
    fi
  fi
  printf '%s' "$DROPLETS_JSON"
  return "$DROPLETS_RC"
}

# Flatten doctl's droplet objects to the fields sleipnir shows. Kept in one place
# so the human table and --json can never drift apart. A droplet with no public
# interface (private-only) yields an empty .ip rather than dropping out.
# shellcheck disable=SC2016  # $tag/$region are jq variables bound with --arg, not shell expansions
DROPLET_SELECT='
  [ .[] | {
      name:   (.name // ""),
      ip:     (((.networks.v4 // []) | map(select(.type == "public")) | .[0].ip_address) // ""),
      region: (.region.slug // ""),
      size:   (.size_slug // ""),
      price:  (.size.price_monthly // null),
      tags:   (.tags // []),
      status: (.status // "")
  } ]
  | map(select($tag == "" or (.tags | index($tag))))
  | map(select($region == "" or .region == $region))
  | sort_by(.name)'

# ── ls ────────────────────────────────────────────────────────────────────────
cmd_ls(){
  is_help "${1:-}" && { help_ls; return 0; }
  local tag="" region="" as_json=0
  while [ $# -gt 0 ]; do case "$1" in
    --tag)    shift; tag="${1:-}";;
    --region) shift; region="${1:-}";;
    --json)   as_json=1;;
    -*) warn "ignoring unknown option: $1";;
    *)  warn "ignoring unexpected argument: $1";;
  esac; shift || true; done

  require_doctl || return 1
  local json; json="$(droplets_json)"; local rc=$?

  if [ "$as_json" = 1 ]; then
    jq --arg tag "$tag" --arg region "$region" "$DROPLET_SELECT" <<<"$json"
    return "$rc"
  fi
  [ "$rc" -ne 0 ] && return "$rc"

  local rows
  rows="$(jq -r --arg tag "$tag" --arg region "$region" \
    "$DROPLET_SELECT | .[] | [.name, .ip, .region, .size, (.price // \"\"), (.tags | join(\",\")), .status] | @tsv" \
    <<<"$json")"

  local filters=""
  [ -n "$tag" ]    && filters=" ${DIM}· tag $tag${X}"
  [ -n "$region" ] && filters="$filters ${DIM}· region $region${X}"
  printf "\n  ${BD}droplets${X}  ${DIM}· %s${X}%s\n\n" "$(context_line)" "$filters"

  if [ -z "$rows" ]; then
    printf "  ${DIM}no droplets%s.${X}\n\n" "$([ -n "$tag$region" ] && printf ' match that filter')"
    return 0
  fi

  # Width pass first: printf (not `column -t`) does the alignment, because column
  # counts ANSI escapes as printable characters and skews every colored row.
  local name ip region_s size price tags status
  local w_name=4 w_ip=2 w_region=6 w_size=4
  while IFS=$'\t' read -r name ip region_s size price tags status; do
    [ "${#name}" -gt "$w_name" ]     && w_name="${#name}"
    [ "${#ip}" -gt "$w_ip" ]         && w_ip="${#ip}"
    [ "${#region_s}" -gt "$w_region" ] && w_region="${#region_s}"
    [ "${#size}" -gt "$w_size" ]     && w_size="${#size}"
  done <<<"$rows"

  local n=0 total=0 scolor
  while IFS=$'\t' read -r name ip region_s size price tags status; do
    [ -z "$name" ] && continue
    case "$status" in
      active)      scolor="$G";;
      new)         scolor="$Y";;
      off|archive) scolor="$DIM";;
      *)           scolor="$R";;
    esac
    printf "  ${C}%-*s${X}  %-*s  ${DIM}%-*s${X}  %-*s  %8s  ${scolor}%-8s${X}  ${DIM}%s${X}\n" \
      "$w_name" "$name" \
      "$w_ip" "${ip:-—}" \
      "$w_region" "$region_s" \
      "$w_size" "$size" \
      "$([ -n "$price" ] && printf '$%s/mo' "$price" || printf '—')" \
      "$status" \
      "${tags:-—}"
    n=$((n + 1))
    [ -n "$price" ] && total="$(awk -v a="$total" -v b="$price" 'BEGIN{printf "%.2f", a + b}')"
  done <<<"$rows"

  printf "\n  ${BD}%d droplet%s${X}  ${DIM}· ~\$%s/mo${X}\n\n" \
    "$n" "$([ "$n" = 1 ] || printf 's')" "$(awk -v t="$total" 'BEGIN{printf (t == int(t)) ? "%d" : "%.2f", t}')"
}

# ── ip ────────────────────────────────────────────────────────────────────────
# Resolve a droplet name to its public IPv4 on stdout. Everything else goes to
# stderr so `ssh root@$(sleipnir ip web)` is safe to embed. Exact match first,
# then a case-insensitive retry; anything ambiguous is an error, never a guess.
droplet_ip(){
  local name="$1" json matches ips
  json="$(droplets_json)" || return 1

  matches="$(jq -r --arg n "$name" '[.[] | select(.name == $n)] | length' <<<"$json")"
  [ "$matches" = 0 ] && matches="$(jq -r --arg n "$name" \
    '[.[] | select((.name | ascii_downcase) == ($n | ascii_downcase))] | length' <<<"$json")"

  if [ "$matches" = 0 ]; then
    printf "  ${R}no droplet named '%s'${X} ${DIM}· %s${X}\n" "$name" "$(context_line)" >&2
    local near
    near="$(jq -r --arg n "$name" \
      '[.[] | select(.name | ascii_downcase | contains($n | ascii_downcase)) | .name] | join(", ")' <<<"$json")"
    [ -n "$near" ] && printf "  ${DIM}did you mean: %s${X}\n" "$near" >&2
    printf "  ${DIM}list them all:  %s ls${X}\n" "$PROG" >&2
    return 1
  fi
  if [ "$matches" -gt 1 ]; then
    printf "  ${R}'%s' matches %s droplets${X} ${DIM}· %s${X}\n" "$name" "$matches" "$(context_line)" >&2
    printf "  ${DIM}DigitalOcean allows duplicate names — rename one, or act by ID with doctl.${X}\n" >&2
    return 1
  fi

  ips="$(jq -r --arg n "$name" \
    '.[] | select((.name | ascii_downcase) == ($n | ascii_downcase))
         | ((.networks.v4 // []) | map(select(.type == "public")) | .[0].ip_address) // ""' <<<"$json")"
  if [ -z "$ips" ]; then
    printf "  ${R}'%s' has no public IPv4${X} ${DIM}(private-only droplet)${X}\n" "$name" >&2
    return 1
  fi
  printf '%s\n' "$ips"
}

cmd_ip(){
  is_help "${1:-}" && { help_ip; return 0; }
  local name="${1:-}"
  [ -n "$name" ] || { printf "  ${R}usage:${X} $PROG ip <droplet-name>\n" >&2; return 1; }
  require_doctl || return 1
  droplet_ip "$name"
}

# ── config ────────────────────────────────────────────────────────────────────
cmd_config(){
  is_help "${1:-}" && { help_config; return 0; }
  printf "\n  ${BD}sleipnir config${X}\n\n"
  printf "    file        ${C}%s${X} %s\n" "$CONFIG" \
    "$([ -f "$CONFIG" ] && printf "${G}(loaded)${X}" || printf "${DIM}(none yet — run: %s install)${X}" "$PROG")"
  printf "    region      %s\n" "$REGION"
  printf "    ssh user    %s\n" "$SSH_USER"
  printf "    ssh key     %s\n" "${SSH_IDENTITY:-${DIM}(ssh decides)${X}}"
  if have doctl; then
    local ctx acct
    ctx="$(do_context)"; acct="$(account_label)"
    printf "    doctl       ${C}%s${X}\n" "${ctx:-${DIM}no context${X}}"
    printf "    account     %s\n" "${acct:-${DIM}not authenticated${X}}"
  else
    printf "    doctl       ${Y}not installed${X}\n"
  fi
  printf "\n  ${DIM}SLEIPNIR_* environment variables override the file. doctl owns your DO\n"
  printf "  token — sleipnir never reads, stores, or logs it.${X}\n\n"
}

# ── ssh ───────────────────────────────────────────────────────────────────────
# Resolve a droplet name to its IP and hand the terminal to ssh. Everything after
# `--` goes to ssh untouched, so the usual escape hatches (-L, -A, a remote
# command) all still work:  sleipnir ssh web -- -L 8080:localhost:80
cmd_ssh(){
  is_help "${1:-}" && { help_ssh; return 0; }
  local name="" user="$SSH_USER" identity="$SSH_IDENTITY"
  local -a passthru=()
  while [ $# -gt 0 ]; do case "$1" in
    --)          shift; passthru+=("$@"); break;;
    -u|--user)   shift; user="${1:-}";;
    -i|--identity) shift; identity="${1:-}";;
    -*)          warn "ignoring unknown option: $1";;
    *)           [ -z "$name" ] && name="$1" || passthru+=("$1");;
  esac; shift || true; done

  [ -n "$name" ] || { printf "  ${R}usage:${X} $PROG ssh <droplet-name> [-u user] [-- <ssh args>]\n" >&2; return 1; }
  [ -n "$user" ] || { printf "  ${R}--user needs a value${X}\n" >&2; return 1; }
  have ssh || die "ssh not found — install an OpenSSH client first."
  require_doctl || return 1

  local ip; ip="$(droplet_ip "$name")" || return 1

  local -a ssh_args=()
  if [ -n "$identity" ]; then
    [ -r "$identity" ] || { printf "  ${R}identity file not readable:${X} %s\n" "$identity" >&2; return 1; }
    ssh_args+=(-i "$identity")
  fi
  # Pass-through args go AFTER the host, deliberately. OpenSSH re-enters its
  # option loop once it has consumed the hostname, so post-host flags are still
  # parsed as flags (`ssh host -L 8080:localhost:80` really does forward) — while
  # a remote command only works in this position. One slot handles both; moving
  # these before the host would break `sleipnir ssh web -- systemctl status x`.
  ssh_args+=("$user@$ip")
  [ "${#passthru[@]}" -gt 0 ] && ssh_args+=("${passthru[@]}")

  # Announce the target on stderr — it names the account you are about to touch,
  # and stays out of the way of any command output ssh brings back.
  printf "  ${DIM}→ %s@%s${X} ${DIM}(%s · %s)${X}\n" "$user" "$ip" "$name" "$(context_line)" >&2
  exec ssh "${ssh_args[@]}"
}

# ── install ───────────────────────────────────────────────────────────────────
# Write a starter config. Refuses to clobber an existing one without --force,
# because that file is hand-tuned and losing it is a real (if small) loss.
cmd_install(){
  is_help "${1:-}" && { help_install; return 0; }
  local force=0
  while [ $# -gt 0 ]; do case "$1" in
    -f|--force) force=1;;
    -*) warn "ignoring unknown option: $1";;
    *)  warn "ignoring unexpected argument: $1";;
  esac; shift || true; done

  if [ -f "$CONFIG" ] && [ "$force" = 0 ]; then
    printf "\n  config already exists → ${C}%s${X}\n" "$CONFIG"
    printf "  ${DIM}edit it directly, or '%s install --force' to overwrite.${X}\n\n" "$PROG"
    return 0
  fi

  # Prefill the SSH-key fingerprints from the account when doctl can tell us —
  # they are public identifiers, not secrets, and they live only in this local
  # file. Silently left blank when doctl is absent or unauthenticated.
  local keys=""
  if have doctl && have jq && account_json >/dev/null 2>&1; then
    keys="$(doctl compute ssh-key list --output json 2>/dev/null \
      | jq -r 'if type == "array" then [.[].fingerprint] | join(",") else "" end' 2>/dev/null)"
  fi

  mkdir -p "$(dirname "$CONFIG")" || { printf "  ${R}could not create %s${X}\n" "$(dirname "$CONFIG")" >&2; return 1; }
  cat > "$CONFIG" <<CFG || { printf "  ${R}could not write %s${X}\n" "$CONFIG" >&2; return 1; }
# sleipnir configuration — https://github.com/brett-buskirk/sleipnir
#
# Plain shell assignments, sourced at startup. Keep it SECRET-FREE: doctl owns
# your DO API token, sleipnir never touches it. SLEIPNIR_* environment variables
# override anything set here.

# Defaults for new resources and connections
SLEIPNIR_REGION="$REGION"
SLEIPNIR_SSH_USER="$SSH_USER"

# Local private key for 'sleipnir ssh' (passed to ssh -i). Blank = let ssh decide.
SLEIPNIR_SSH_IDENTITY="$SSH_IDENTITY"

# Public-key FINGERPRINTS for doctl to attach when creating droplets (v2+).
# Not secrets, and not the same thing as SLEIPNIR_SSH_IDENTITY above.
# List them any time with:  doctl compute ssh-key list
SLEIPNIR_SSH_KEYS="$keys"

# Default tag(s) sleipnir stamps on resources it creates (v2+)
SLEIPNIR_TAGS="sleipnir"
CFG

  chmod 600 "$CONFIG" 2>/dev/null
  printf "\n  ${G}✓${X} wrote ${C}%s${X}%s\n\n" "$CONFIG" \
    "$([ -n "$keys" ] && printf " ${DIM}(ssh-key fingerprints prefilled from the account)${X}")"
  sed 's/^/    /' "$CONFIG"
  printf "\n  ${DIM}Edit as needed, then check it with '%s config'.${X}\n\n" "$PROG"
}

# ── App Platform ──────────────────────────────────────────────────────────────
# Memoized, same contract as droplets_json: non-zero means doctl failed, which is
# not the same as an account with no apps.
APPS_JSON=""; APPS_RC=-1
apps_json(){
  if [ "$APPS_RC" -lt 0 ]; then
    local raw
    raw="$(doctl apps list --output json 2>&1)"; APPS_RC=$?
    if [ "$APPS_RC" -ne 0 ]; then
      warn "doctl could not list apps — $(head -1 <<<"$raw")"
      APPS_JSON='[]'
    elif jq -e 'type == "array"' >/dev/null 2>&1 <<<"$raw"; then
      APPS_JSON="$raw"
    else
      APPS_JSON='[]'
    fi
  fi
  printf '%s' "$APPS_JSON"
  return "$APPS_RC"
}

# Flatten an app to the fields sleipnir shows. `runtime` counts the components
# that actually execute — services, workers, jobs. It drives the log-type default
# below, because a site with none of them has no run logs to tail.
APP_SELECT='
  [ .[] | {
      name:    (.spec.name // ""),
      id:      (.id // ""),
      region:  (.region.slug // ""),
      tier:    (.tier_slug // ""),
      url:     (.live_url // .default_ingress // ""),
      phase:   (.active_deployment.phase // ""),
      deployed: ((.active_deployment.updated_at // .last_deployment_active_at // null) | epoch),
      runtime: (((.spec.services // []) | length)
                + ((.spec.workers // []) | length)
                + ((.spec.jobs // []) | length)),
      components: ([ (if ((.spec.services // []) | length) > 0 then "svc:\((.spec.services | length))" else empty end),
                     (if ((.spec.static_sites // []) | length) > 0 then "static:\((.spec.static_sites | length))" else empty end),
                     (if ((.spec.workers // []) | length) > 0 then "worker:\((.spec.workers | length))" else empty end),
                     (if ((.spec.jobs // []) | length) > 0 then "job:\((.spec.jobs | length))" else empty end),
                     (if ((.spec.functions // []) | length) > 0 then "fn:\((.spec.functions | length))" else empty end)
                   ] | join(" "))
  } ] | sort_by(.name)'

# Resolve an app name to one flattened record on stdout. Same matching discipline
# as droplet_ip: exact, then case-insensitive, and ambiguity is an error. This
# exists because `doctl apps list-deployments` demands a UUID and refuses a name.
app_record(){
  local name="$1" json n
  json="$(apps_json)" || return 1
  n="$(jq -r --arg n "$name" "$JQ_EPOCH $APP_SELECT | [ .[] | select(.name == \$n) ] | length" <<<"$json")"
  [ "$n" = 0 ] && n="$(jq -r --arg n "$name" \
    "$JQ_EPOCH $APP_SELECT | [ .[] | select((.name | ascii_downcase) == (\$n | ascii_downcase)) ] | length" <<<"$json")"

  if [ "$n" = 0 ]; then
    printf "  ${R}no app named '%s'${X} ${DIM}· %s${X}\n" "$name" "$(context_line)" >&2
    local near
    near="$(jq -r --arg n "$name" \
      '[ .[] | select((.spec.name // "") | ascii_downcase | contains($n | ascii_downcase)) | .spec.name ] | join(", ")' <<<"$json")"
    [ -n "$near" ] && printf "  ${DIM}did you mean: %s${X}\n" "$near" >&2
    printf "  ${DIM}list them all:  %s apps${X}\n" "$PROG" >&2
    return 1
  fi
  if [ "$n" -gt 1 ]; then
    printf "  ${R}'%s' matches %s apps${X} ${DIM}· %s${X}\n" "$name" "$n" "$(context_line)" >&2
    return 1
  fi
  jq -r --arg n "$name" \
    "$JQ_EPOCH $APP_SELECT | .[] | select((.name | ascii_downcase) == (\$n | ascii_downcase))" <<<"$json"
}

# Colour a droplet status by what it means for you. Shared by `ls` and `survey`
# so the same word never renders two different ways.
status_color(){
  case "$1" in
    active)      printf '%s' "$G";;
    new)         printf '%s' "$Y";;
    off|archive) printf '%s' "$DIM";;
    *)           printf '%s' "$R";;
  esac
}

# Colour a deployment/app phase by what it means for you.
phase_color(){
  case "$1" in
    ACTIVE|SUPERSEDED) printf '%s' "$G";;
    ERROR|CANCELED)    printf '%s' "$R";;
    "")                printf '%s' "$DIM";;
    *)                 printf '%s' "$Y";;   # BUILDING, DEPLOYING, PENDING…
  esac
}

cmd_apps(){
  is_help "${1:-}" && { help_apps; return 0; }
  local as_json=0
  while [ $# -gt 0 ]; do case "$1" in
    --json) as_json=1;;
    -*) warn "ignoring unknown option: $1";;
    *)  warn "ignoring unexpected argument: $1";;
  esac; shift || true; done

  require_doctl || return 1
  local json; json="$(apps_json)"; local rc=$?

  if [ "$as_json" = 1 ]; then
    jq "$JQ_EPOCH $APP_SELECT" <<<"$json"
    return "$rc"
  fi
  [ "$rc" -ne 0 ] && return "$rc"

  local rows
  rows="$(jq -r "$JQ_EPOCH $APP_SELECT | .[] | [.name, .phase, (.deployed // \"\"), .components, .region, .tier, .url] | @tsv" <<<"$json")"

  printf "\n  ${BD}App Platform${X}  ${DIM}· %s${X}\n\n" "$(context_line)"
  if [ -z "$rows" ]; then
    printf "  ${DIM}no apps.${X}\n\n"; return 0
  fi

  local name phase deployed comps region tier url
  local w_name=4 w_phase=5 w_comps=10
  while IFS=$'\t' read -r name phase deployed comps region tier url; do
    [ "${#name}" -gt "$w_name" ]   && w_name="${#name}"
    [ "${#phase}" -gt "$w_phase" ] && w_phase="${#phase}"
    [ "${#comps}" -gt "$w_comps" ] && w_comps="${#comps}"
  done <<<"$rows"

  local n=0
  while IFS=$'\t' read -r name phase deployed comps region tier url; do
    [ -z "$name" ] && continue
    printf "  ${C}%-*s${X}  $(phase_color "$phase")%-*s${X}  %5s  ${DIM}%-*s${X}  ${DIM}%-5s %-8s${X}  %s\n" \
      "$w_name" "$name" "$w_phase" "$phase" "$(age_short "$deployed")" \
      "$w_comps" "$comps" "$region" "$tier" "$url"
    n=$((n + 1))
  done <<<"$rows"

  printf "\n  ${BD}%d app%s${X}  ${DIM}· age is time since the last deployment · %s deploys <app> for history${X}\n\n" \
    "$n" "$([ "$n" = 1 ] || printf 's')" "$PROG"
}

cmd_deploys(){
  is_help "${1:-}" && { help_deploys; return 0; }
  local app="" limit=10 as_json=0
  while [ $# -gt 0 ]; do case "$1" in
    -n|--limit) shift; limit="${1:-10}";;
    --json)     as_json=1;;
    -*) warn "ignoring unknown option: $1";;
    *)  if [ -z "$app" ]; then app="$1"; else warn "ignoring unexpected argument: $1"; fi;;
  esac; shift || true; done

  [ -n "$app" ] || { printf "  ${R}usage:${X} $PROG deploys <app> [-n <count>] [--json]\n" >&2; return 1; }
  if ! [[ "$limit" =~ ^[1-9][0-9]*$ ]]; then
    printf "  ${R}-n needs a positive number${X}\n" >&2; return 1
  fi
  require_doctl || return 1

  local rec id name; rec="$(app_record "$app")" || return 1
  id="$(jq -r '.id' <<<"$rec")"; name="$(jq -r '.name' <<<"$rec")"

  local raw rc
  raw="$(doctl apps list-deployments "$id" --output json 2>&1)"; rc=$?
  if [ "$rc" -ne 0 ] || ! jq -e 'type == "array"' >/dev/null 2>&1 <<<"$raw"; then
    printf "  ${R}could not list deployments for '%s'${X}\n  ${DIM}%s${X}\n" "$name" "$(head -1 <<<"$raw")" >&2
    return 1
  fi

  local sel="$JQ_EPOCH
    [ .[] | { id: (.id // \"\"), phase: (.phase // \"\"),
              created: ((.created_at // null) | epoch),
              cause: (.cause // \"\") } ]
    | sort_by(.created) | reverse | .[0:$limit]"

  if [ "$as_json" = 1 ]; then jq "$sel" <<<"$raw"; return 0; fi

  printf "\n  ${BD}deployments${X} ${DIM}· %s · %s${X}\n\n" "$name" "$(context_line)"
  local rows; rows="$(jq -r "$sel | .[] | [.id, .phase, (.created // \"\"), .cause] | @tsv" <<<"$raw")"
  if [ -z "$rows" ]; then printf "  ${DIM}no deployments.${X}\n\n"; return 0; fi

  local did phase created cause n=0 w_phase=5
  while IFS=$'\t' read -r did phase created cause; do
    [ "${#phase}" -gt "$w_phase" ] && w_phase="${#phase}"
  done <<<"$rows"
  while IFS=$'\t' read -r did phase created cause; do
    [ -z "$did" ] && continue
    printf "  ${DIM}%s${X}  $(phase_color "$phase")%-*s${X}  %5s  %s\n" \
      "${did:0:8}" "$w_phase" "$phase" "$(age_short "$created")" "$cause"
    n=$((n + 1))
  done <<<"$rows"
  printf "\n  ${BD}%d shown${X}  ${DIM}· newest first · %s logs %s  to read them${X}\n\n" "$n" "$PROG" "$name"
}

cmd_logs(){
  is_help "${1:-}" && { help_logs; return 0; }
  local app="" component="" type="" follow=0 tail_n=""
  while [ $# -gt 0 ]; do case "$1" in
    -f|--follow) follow=1;;
    -n|--tail)   shift; tail_n="${1:-}";;
    --type)      shift; type="${1:-}";;
    -*) warn "ignoring unknown option: $1";;
    *)  if   [ -z "$app" ];       then app="$1"
        elif [ -z "$component" ]; then component="$1"
        else warn "ignoring unexpected argument: $1"; fi;;
  esac; shift || true; done

  [ -n "$app" ] || { printf "  ${R}usage:${X} $PROG logs <app> [component] [-f] [-n <lines>] [--type build|deploy|run]\n" >&2; return 1; }
  case "$type" in
    ""|build|deploy|run) ;;
    *) printf "  ${R}--type must be one of: build, deploy, run${X}\n" >&2; return 1;;
  esac
  [ -n "$tail_n" ] && { [[ "$tail_n" =~ ^[0-9]+$ ]] || { printf "  ${R}-n needs a number${X}\n" >&2; return 1; }; }
  require_doctl || return 1

  local rec name runtime; rec="$(app_record "$app")" || return 1
  name="$(jq -r '.name' <<<"$rec")"; runtime="$(jq -r '.runtime' <<<"$rec")"

  # doctl defaults to run logs, which is the wrong default for an app with no
  # running component: a static site has no runtime, so the request hangs on a
  # websocket that never delivers. Pick build logs in that case and say so —
  # this is the "sane defaults" the wrapper exists to provide.
  local chose=""
  if [ -z "$type" ]; then
    if [ "$runtime" = 0 ]; then type="build"; chose=" ${DIM}(no runtime component — showing build logs)${X}"
    else type="run"; fi
  fi

  local -a args=(apps logs "$name")
  [ -n "$component" ] && args+=("$component")
  args+=(--type "$type")
  [ -n "$tail_n" ] && args+=(--tail "$tail_n")
  [ "$follow" = 1 ] && args+=(--follow)

  printf "  ${DIM}→ %s %s logs · %s${X}%s\n" "$name" "$type" "$(context_line)" "$chose" >&2
  exec doctl "${args[@]}"
}

# ── survey ────────────────────────────────────────────────────────────────────
# Generic list fetch for the resources survey counts. doctl emits [] for an empty
# account, so an empty array honestly means "none" — but a non-zero exit means we
# could not ask, and the renderer must not show that as "none". Every section
# distinguishes the two.
doctl_list(){
  local raw rc
  raw="$(doctl "$@" --output json 2>&1)"; rc=$?
  if [ "$rc" -eq 0 ] && jq -e 'type == "array"' >/dev/null 2>&1 <<<"$raw"; then
    printf '%s' "$raw"; return 0
  fi
  printf '%s' '[]'; return 1
}

# Render one "counted, not priced" line: a count, "none", or an honest "unknown"
# when the API call failed.
survey_count(){
  local label="$1" json="$2" rc="$3" n
  if [ "$rc" -ne 0 ]; then
    printf "  %-16s ${Y}unknown${X} ${DIM}(doctl could not list them)${X}\n" "$label"; return
  fi
  n="$(jq -r 'length' <<<"$json" 2>/dev/null || printf 0)"
  if [ "$n" = 0 ]; then printf "  %-16s ${DIM}none${X}\n" "$label"
  else printf "  %-16s ${BD}%s${X}\n" "$label" "$n"; fi
}

cmd_survey(){
  is_help "${1:-}" && { help_survey; return 0; }
  local as_json=0
  while [ $# -gt 0 ]; do case "$1" in
    --json) as_json=1;;
    -*) warn "ignoring unknown option: $1";;
    *)  warn "ignoring unexpected argument: $1";;
  esac; shift || true; done
  require_doctl || return 1

  local dj aj vols fws rips dbs lbs k8s
  local dj_rc=0 aj_rc=0 vols_rc fws_rc rips_rc dbs_rc lbs_rc k8s_rc
  dj="$(droplets_json)" || dj_rc=1
  aj="$(apps_json)"     || aj_rc=1
  vols="$(doctl_list compute volume list)";        vols_rc=$?
  fws="$(doctl_list compute firewall list)";       fws_rc=$?
  rips="$(doctl_list compute reserved-ip list)";   rips_rc=$?
  dbs="$(doctl_list databases list)";              dbs_rc=$?
  lbs="$(doctl_list compute load-balancer list)";  lbs_rc=$?
  k8s="$(doctl_list kubernetes cluster list)";     k8s_rc=$?

  # What we can price honestly: droplet list price, and block storage at the
  # configured per-GiB rate. Everything else is counted, not costed — see the
  # note under the total and in `survey help`.
  local d_cost v_gib v_cost total
  d_cost="$(jq -r '[.[].size.price_monthly // 0] | add // 0' <<<"$dj")"
  v_gib="$(jq -r '[.[].size_gigabytes // 0] | add // 0' <<<"$vols")"
  v_cost="$(awk -v g="$v_gib" -v r="$VOLUME_PRICE_GIB" 'BEGIN{printf "%.2f", g * r}')"
  total="$(awk -v a="$d_cost" -v b="$v_cost" 'BEGIN{printf "%.2f", a + b}')"

  if [ "$as_json" = 1 ]; then
    jq -n \
      --arg account "$(account_label)" --arg context "$(do_context)" \
      --argjson droplets "$dj" --argjson apps "$aj" --argjson volumes "$vols" \
      --argjson firewalls "$fws" --argjson reservedIps "$rips" --argjson databases "$dbs" \
      --argjson loadBalancers "$lbs" --argjson kubernetes "$k8s" \
      --argjson dropletMonthly "$d_cost" --argjson volumeMonthly "$v_cost" \
      --argjson estimatedMonthly "$total" --argjson volumeGib "$v_gib" \
      '{ account: $account, context: $context,
         droplets:      { count: ($droplets|length),      monthly: $dropletMonthly },
         apps:          { count: ($apps|length) },
         volumes:       { count: ($volumes|length), gib: $volumeGib, monthly: $volumeMonthly },
         firewalls:     { count: ($firewalls|length) },
         reservedIps:   { count: ($reservedIps|length) },
         databases:     { count: ($databases|length) },
         loadBalancers: { count: ($loadBalancers|length) },
         kubernetes:    { count: ($kubernetes|length) },
         estimatedMonthly: $estimatedMonthly,
         priced: ["droplets", "volumes"],
         notes: ["Spaces buckets are not listable via doctl.",
                 "Cost covers droplet list price and block storage only."] }'
    return 0
  fi

  printf "\n  ${BD}survey${X}  ${DIM}· %s${X}\n" "$(context_line)"
  printf "  ${DIM}(network — several API calls)${X}\n\n"

  # droplets
  if [ "$dj_rc" -ne 0 ]; then
    printf "  ${BD}droplets${X}         ${Y}unknown${X} ${DIM}(doctl could not list them)${X}\n\n"
  else
    local dn; dn="$(jq -r 'length' <<<"$dj")"
    printf "  ${BD}droplets${X}         ${BD}%s${X}%s\n" "$dn" \
      "$([ "$dn" != 0 ] && printf "  ${DIM}~\$%s/mo${X}" "$(awk -v t="$d_cost" 'BEGIN{printf (t==int(t))?"%d":"%.2f", t}')")"
    jq -r '.[] | [.name,
                  (((.networks.v4 // []) | map(select(.type == "public")) | .[0].ip_address) // "—"),
                  .region.slug, .size_slug, (.size.price_monthly // 0 | tostring), .status] | @tsv' <<<"$dj" \
    | while IFS=$'\t' read -r n ip rg sz pr st; do
        printf "    ${C}%-20s${X} %-16s ${DIM}%-6s %-14s${X} %7s  $(status_color "$st")%s${X}\n" \
          "$n" "$ip" "$rg" "$sz" "\$$pr/mo" "$st"

      done
    printf "\n"
  fi

  # App Platform
  if [ "$aj_rc" -ne 0 ]; then
    printf "  ${BD}apps${X}             ${Y}unknown${X} ${DIM}(doctl could not list them)${X}\n\n"
  else
    local an; an="$(jq -r 'length' <<<"$aj")"
    printf "  ${BD}apps${X}             ${BD}%s${X}  ${DIM}(App Platform — not costed below)${X}\n" "$an"
    jq -r "$JQ_EPOCH $APP_SELECT | .[] | [.name, .phase, (.deployed // \"\"), .url] | @tsv" <<<"$aj" \
    | while IFS=$'\t' read -r n ph dep url; do
        printf "    ${C}%-20s${X} $(phase_color "$ph")%-10s${X} %5s  ${DIM}%s${X}\n" \
          "$n" "$ph" "$(age_short "$dep")" "$url"
      done
    printf "\n"
  fi

  # volumes — priced, and worth showing what they are attached to
  if [ "$vols_rc" -ne 0 ]; then
    printf "  ${BD}volumes${X}          ${Y}unknown${X} ${DIM}(doctl could not list them)${X}\n\n"
  else
    local vn; vn="$(jq -r 'length' <<<"$vols")"
    printf "  ${BD}volumes${X}          ${BD}%s${X}%s\n" "$vn" \
      "$([ "$vn" != 0 ] && printf "  ${DIM}%s GiB · ~\$%s/mo${X}" "$v_gib" "$(awk -v t="$v_cost" 'BEGIN{printf (t==int(t))?"%d":"%.2f", t}')")"
    [ "$vn" != 0 ] && jq -r --argjson d "$dj" \
      '.[] | [.name, (.size_gigabytes | tostring), (.region.slug // ""),
              ([.droplet_ids[]? as $id | ($d[] | select(.id == $id) | .name)] | join(",") )] | @tsv' <<<"$vols" \
    | while IFS=$'\t' read -r n gib rg att; do
        printf "    ${C}%-20s${X} %5s GiB  ${DIM}%-6s${X}  %s\n" "$n" "$gib" "$rg" \
          "$([ -n "$att" ] && printf "→ %s" "$att" || printf "${Y}unattached${X}")"
      done
    printf "\n"
  fi

  # firewalls — attached droplet count is the useful bit
  if [ "$fws_rc" -ne 0 ]; then
    printf "  ${BD}firewalls${X}        ${Y}unknown${X} ${DIM}(doctl could not list them)${X}\n\n"
  else
    local fn; fn="$(jq -r 'length' <<<"$fws")"
    printf "  ${BD}firewalls${X}        ${BD}%s${X}\n" "$fn"
    [ "$fn" != 0 ] && jq -r '.[] | [.name, (.status // ""), ((.droplet_ids // []) | length | tostring)] | @tsv' <<<"$fws" \
    | while IFS=$'\t' read -r n st nd; do
        printf "    ${C}%-28s${X} ${DIM}%-10s${X} %s droplet%s\n" "$n" "$st" "$nd" "$([ "$nd" = 1 ] || printf 's')"
      done
    printf "\n"
  fi

  # The rest: counted only.
  survey_count "reserved IPs"   "$rips" "$rips_rc"
  survey_count "databases"      "$dbs"  "$dbs_rc"
  survey_count "load balancers" "$lbs"  "$lbs_rc"
  survey_count "kubernetes"     "$k8s"  "$k8s_rc"
  printf "  %-16s ${DIM}not listable via doctl${X}\n" "Spaces"

  # Name exactly what the number covers. If a priced lookup failed we counted it
  # as zero, so the total is an UNDERCOUNT and must not claim otherwise — a cost
  # figure that quietly omits a line item is worse than no figure at all.
  local covers="droplets + block storage"
  [ "$dj_rc"   -ne 0 ] && covers="block storage only ${R}(droplets unreadable)${X}"
  [ "$vols_rc" -ne 0 ] && covers="droplets only ${R}(block storage unreadable)${X}"
  if [ "$dj_rc" -ne 0 ] && [ "$vols_rc" -ne 0 ]; then covers="${R}nothing — both priced lookups failed${X}"; fi

  printf "\n  ${BD}estimated  ~\$%s/mo${X}  ${DIM}· %s${X}\n" \
    "$(awk -v t="$total" 'BEGIN{printf (t==int(t))?"%d":"%.2f", t}')" "$covers"
  printf "  ${DIM}Apps, databases, load balancers, snapshots, backups, and bandwidth are not\n"
  printf "  included. A glance, not an invoice — '%s help survey' explains why.${X}\n\n" "$PROG"
}

# ── help ──────────────────────────────────────────────────────────────────────
help_ls(){
  printf "\n  ${BD}$PROG ls${X} [--tag <tag>] [--region <slug>] [--json]\n\n"
  printf "  Every droplet on the active account — name · public IPv4 · region · size ·\n"
  printf "  estimated \$/mo · status · tags, with a monthly total. The header names the\n"
  printf "  account and doctl context the numbers came from. ${DIM}(network — one API call)${X}\n\n"
  printf "  ${BD}Options${X}\n"
  printf "    --tag <tag>       only droplets carrying this tag\n"
  printf "    --region <slug>   only droplets in this region (nyc3, sfo3, …)\n"
  printf "    --json            machine-readable rows instead of the table\n\n"
  printf "  ${DIM}Cost is doctl's list price for the size — it ignores volumes, snapshots,\n"
  printf "  backups, and bandwidth. Treat it as a glance, not an invoice.${X}\n\n"
}
help_ip(){
  printf "\n  ${BD}$PROG ip${X} <droplet-name>\n\n"
  printf "  Print just the public IPv4 of a droplet — nothing else on stdout, so it drops\n"
  printf "  straight into other commands. Exits non-zero if the name doesn't resolve.\n\n"
  printf "  ${BD}Examples${X}\n"
  printf "    ssh root@\$($PROG ip vor-analytics)\n"
  printf "    ansible-playbook -i \"\$($PROG ip web),\" site.yml\n\n"
  printf "  ${DIM}Matching is exact, then case-insensitive. A name that matches more than one\n"
  printf "  droplet is an error, not a guess.${X}\n\n"
}
help_ssh(){
  printf "\n  ${BD}$PROG ssh${X} <droplet-name> [-u <user>] [-i <identity>] [-- <ssh args>]\n\n"
  printf "  Resolve a droplet name to its public IPv4 and connect. The target line goes to\n"
  printf "  stderr before handover, so you always see which host and account you landed on.\n\n"
  printf "  ${BD}Options${X}\n"
  printf "    -u, --user <user>       connect as this user ${DIM}(default: %s)${X}\n" "$SSH_USER"
  printf "    -i, --identity <path>   private key to use ${DIM}(ssh -i)${X}\n"
  printf "    -- <ssh args>           everything after -- is passed to ssh untouched\n\n"
  printf "  ${BD}Examples${X}\n"
  printf "    $PROG ssh vor-analytics\n"
  printf "    $PROG ssh vor-analytics -u deploy\n"
  printf "    $PROG ssh vor-analytics -- -L 8080:localhost:80    ${DIM}# port-forward${X}\n"
  printf "    $PROG ssh vor-analytics -- systemctl status caddy  ${DIM}# run and return${X}\n\n"
  printf "  ${DIM}Name resolution is the same as '$PROG ip' — exact, then case-insensitive,\n"
  printf "  and an ambiguous name is an error rather than a guess.${X}\n\n"
}
help_install(){
  printf "\n  ${BD}$PROG install${X} [--force]\n\n"
  printf "  Write a starter config to the resolved config path, with your current defaults\n"
  printf "  filled in. Refuses to overwrite an existing config unless you pass --force.\n\n"
  printf "  ${BD}Options${X}\n"
  printf "    -f, --force   overwrite an existing config file\n\n"
  printf "  ${DIM}If doctl is authenticated, your SSH-key fingerprints are prefilled (they are\n"
  printf "  public identifiers, not secrets, and never leave this machine). The file is\n"
  printf "  written 0600 and holds no credentials — doctl owns your DO token.${X}\n\n"
}
help_survey(){
  printf "\n  ${BD}$PROG survey${X} [--json]\n\n"
  printf "  The whole-estate view: droplets, App Platform apps, volumes, firewalls, and a\n"
  printf "  count of reserved IPs, databases, load balancers, and Kubernetes clusters —\n"
  printf "  with an estimated monthly cost. ${DIM}(network — several API calls)${X}\n\n"
  printf "  ${BD}Options${X}\n"
  printf "    --json   one machine-readable object instead of the view\n\n"
  printf "  ${BD}What the cost figure covers${X}\n"
  printf "    ${G}included${X}  droplets ${DIM}(doctl's list price for each size)${X}\n"
  printf "    ${G}included${X}  block storage ${DIM}(volume GiB × \$%s, set by SLEIPNIR_VOLUME_PRICE_GIB)${X}\n" "$VOLUME_PRICE_GIB"
  printf "    ${Y}excluded${X}  App Platform, databases, load balancers, Kubernetes\n"
  printf "    ${Y}excluded${X}  snapshots, backups, bandwidth overage, reserved-IP idle charges\n\n"
  printf "  ${DIM}It is a glance, not an invoice — use it to notice that something is running,\n"
  printf "  not to reconcile a bill. Volumes are the one line sleipnir cannot read a price\n"
  printf "  for, so that rate lives in config where you can correct it.${X}\n\n"
  printf "  ${DIM}Spaces buckets are not listed: doctl exposes only 'spaces keys', with no\n"
  printf "  bucket listing, and sleipnir does not call the DO API directly to fill gaps.${X}\n\n"
}
help_apps(){
  printf "\n  ${BD}$PROG apps${X} [--json]\n\n"
  printf "  Every App Platform app on the active account — name · deployment phase · time\n"
  printf "  since the last deploy · components · region · tier · live URL.\n"
  printf "  ${DIM}(network — one API call)${X}\n\n"
  printf "  ${BD}Options${X}\n"
  printf "    --json   machine-readable rows instead of the table\n\n"
  printf "  ${DIM}Components are counted by kind (svc / static / worker / job / fn). Apps with\n"
  printf "  no svc, worker, or job have no runtime — which is why '$PROG logs' picks\n"
  printf "  build logs for them.${X}\n\n"
}
help_deploys(){
  printf "\n  ${BD}$PROG deploys${X} <app> [-n <count>] [--json]\n\n"
  printf "  Recent deployments for an app, newest first — short id · phase · age · cause\n"
  printf "  (usually the commit that triggered it).\n\n"
  printf "  ${BD}Options${X}\n"
  printf "    -n, --limit <count>   how many to show ${DIM}(default: 10)${X}\n"
  printf "    --json                machine-readable rows\n\n"
  printf "  ${DIM}Takes an app NAME. doctl's own list-deployments demands a UUID and rejects a\n"
  printf "  name outright — sleipnir resolves it for you.${X}\n\n"
}
help_logs(){
  printf "\n  ${BD}$PROG logs${X} <app> [component] [-f] [-n <lines>] [--type build|deploy|run]\n\n"
  printf "  Read an app's logs. Hands off to doctl, so -f streams until you interrupt it.\n\n"
  printf "  ${BD}Options${X}\n"
  printf "    -f, --follow          stream new lines as they arrive\n"
  printf "    -n, --tail <lines>    show only the last N lines\n"
  printf "    --type <type>         build · deploy · run ${DIM}(default: chosen for you, below)${X}\n\n"
  printf "  ${BD}Examples${X}\n"
  printf "    $PROG logs day-one\n"
  printf "    $PROG logs day-one -f              ${DIM}# follow${X}\n"
  printf "    $PROG logs day-one web --type build\n\n"
  printf "  ${DIM}On the default: doctl asks for RUN logs unless told otherwise, but an app with\n"
  printf "  no service, worker, or job has no runtime — that request hangs on a websocket\n"
  printf "  that never delivers. For those apps sleipnir asks for build logs instead, and\n"
  printf "  tells you it did. Pass --type to override. Starter-tier apps have no deploy\n"
  printf "  logs at all; DigitalOcean will say so.${X}\n\n"
}
help_config(){
  printf "\n  ${BD}$PROG config${X}\n\n"
  printf "  Show the resolved configuration: which file was loaded, the defaults in force,\n"
  printf "  and the doctl context + account sleipnir would act on.\n\n"
  printf "  ${DIM}Precedence: SLEIPNIR_* environment variables > the config file > built-in\n"
  printf "  defaults. The file holds no secrets — doctl owns your DO token.${X}\n\n"
}

usage(){
  printf "\n  ${BD}$PROG${X} ${DIM}%s — a fast doctl wrapper for your DigitalOcean estate${X}\n\n" "$VERSION"
  printf "  ${BD}read + navigate${X}\n"
  printf "    ${BD}ls${X} [--tag X] [--region Y]   droplets — name · IP · region · size · \$/mo · tags\n"
  printf "    ${BD}ip${X} <name>                   print a droplet's public IPv4\n"
  printf "    ${BD}ssh${X} <name> [-- <args>]      ssh into a droplet by name\n"
  printf "    ${BD}survey${X}                      whole-estate view + cost tally\n"
  printf "    ${BD}apps${X}                        App Platform apps — phase, age, live URL\n"
  printf "    ${BD}deploys${X} <app>               recent deployments for an app\n"
  printf "    ${BD}logs${X} <app> [component]      read an app's logs ${DIM}(-f to follow)${X}\n\n"
  printf "  ${BD}meta${X}\n"
  printf "    ${BD}config${X}                      resolved config + active doctl context\n"
  printf "    ${BD}install${X}                     write a starter config\n"
  printf "    ${BD}help${X} [command]              this menu, or detail for one command\n"
  printf "    ${BD}version${X}                     print the version\n\n"
  printf "  ${DIM}doctl owns authentication; $PROG never handles your DO token.${X}\n\n"
}

cmd_help(){
  case "${1:-}" in
    ls)      help_ls;;
    ip)      help_ip;;
    ssh)     help_ssh;;
    survey)  help_survey;;
    apps)    help_apps;;
    deploys) help_deploys;;
    logs)    help_logs;;
    config)  help_config;;
    install) help_install;;
    "")     usage;;
    *)      printf "  ${Y}no help for '%s'${X} ${DIM}— run '$PROG help' for the menu.${X}\n" "$1" >&2; return 1;;
  esac
}

main(){
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    ls)                       cmd_ls "$@";;
    ip)                       cmd_ip "$@";;
    ssh)                      cmd_ssh "$@";;
    survey)                   cmd_survey "$@";;
    apps)                     cmd_apps "$@";;
    deploys)                  cmd_deploys "$@";;
    logs)                     cmd_logs "$@";;
    config)                   cmd_config "$@";;
    install)                  cmd_install "$@";;
    help|-h|--help)           cmd_help "$@";;
    version|-v|-V|--version)  printf '%s %s\n' "$PROG" "$VERSION";;
    *) printf "  ${R}unknown command '%s'${X} ${DIM}— run '$PROG help' for the menu.${X}\n" "$cmd" >&2; return 1;;
  esac
}

main "$@"
